  "cards": [
    {
      "dot": "rose",
      "title": "What the agent never sees",
      "items": [
        "No .git, history, authors or commit SHA: only the tree of one commit",
        "Denylisted files (.env, keys, PDFs, archives) are dropped before the scan",
        "Agent egress allows only snapshot-mcp, DNS and the model endpoint"
      ]
    },
    {
      "dot": "amber",
      "title": "Fail-closed publishing",
      "items": [
        "Secrets found: exit 10, nothing uploaded",
        "Submodules or LFS in archive mode: exit 11, use checkout mode",
        "Snapshots and digest index are write-once; only tag index can move"
      ]
    },
    {
      "dot": "violet",
      "title": "Tag and digest",
      "items": [
        "Build pushes image:tag; the registry computes its sha256 digest",
        "CI hands tag and digest to snapshot-publish; multi-arch adds per-platform digests as aliases",
        "The snapshot is filed under the digest; the tag index allows lookup by version",
        "Pods report the digest in imageID, so the agent reads the code that is actually running"
      ]
    },
    {
      "dot": "cyan",
      "title": "Lookup and lifecycle",
      "items": [
        "Retention aborts if any cluster is unreachable or reports zero digests",
        "Separate CI and prod networks: snapshot-transfer carries a one-way, sha256-checked bundle"
      ]
    }
  ]
}